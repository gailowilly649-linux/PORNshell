# ==============================================================================
# PORNshell Git Ignore Configuration
# Protects private development source, PyArmor build artifacts, logs, and venvs
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & build artifacts
*.o
*.obj
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 🔒 Protected Original Source Code & Obfuscation Build Pipeline (Private to prevent reverse engineering)
.src_private/
src_clean/
*.orig.py
*.bak.py
build_obfuscated.sh
build_*.sh
*.obf.sh

# 🛡️ PyArmor internal caches, logs & build temporary trees
.pyarmor/
.pyarmor_home/
pyarmor.bug.log
pyarmor.debug.log
*.pyarmor_capsule.zip
pyarmor_runtime_*/
**/.pyarmor_home/
**/pyarmor.bug.log
**/pyarmor.debug.log
**/pyarmor_runtime_*/
dist_*/
test_dist/

# Testing & coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# IDEs, OS & Editor temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Generated audit output reports & raw telemetry dumps (ignore dynamic scan outputs)
PORNHUB_EXPLOIT_REPORT.md
*_EXPLOIT_REPORT.md
*_exploit_report.md
dns_audit_report.json
dns_audit_report.md
sink_hunt_report.json
scan_report.json
scan_report.md
rce_audit_report.json
rce_audit_report.md
pornhub_audit.json
pornhub_audit.md
*_audit.json
*_audit.md
*.audit.json
*.audit.md
*_report.json
*_report.md
*.report.json
*.report.md
test_security_regression.py

# Temporary test harnesses, diffs & scratch scripts
test_*.py
!test_security_regression.py
*.head
*.diff
*.patch

# Sensitive credentials, certificates and dumps
*.pem
*.key
*.crt
*.pfx
*.p12
*.id_rsa
*.id_ed25519
.env.*
!.env.example
